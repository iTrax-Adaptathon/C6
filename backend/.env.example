# Copy this file to backend/.env and add your own secret. Never commit .env.
# OPENAI_API_KEY is required for the shared judge.
OPENAI_API_KEY=
# Use a model that supports the Responses API and structured JSON output.
OPENAI_MODEL=gpt-4.1-mini
# Enables personal OpenAI / compatible Responses API credentials for one request.
# Keep false for public deployments unless authentication and rate limits are added.
ALLOW_CUSTOM_PROVIDER=false
# Run two label-order evaluations and average their scores.
ENABLE_DUAL_PASS=true
# Defaults to SQLite; use a PostgreSQL URL in production when needed.
DATABASE_URL=sqlite:///./debates.db
# Allow a local deterministic demo result when no AI key is configured.
DEMO_FALLBACK=true
