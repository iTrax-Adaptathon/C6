# Copy this file to .env and add your own secret. Never commit .env.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
ALLOWED_ORIGINS=http://127.0.0.1:5500,http://localhost:5500
# Enables personal OpenAI / compatible Responses API credentials for one request.
# Keep false for public deployments unless you have authentication and rate limits.
ALLOW_CUSTOM_PROVIDER=true
